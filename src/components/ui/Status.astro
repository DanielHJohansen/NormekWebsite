---
/**
 * A status message (tokens.md 5.9): the surface colour, a 4 px left rule, a shape coded icon and text.
 * Colour is never the only cue. Success uses role="status", a failure role="alert", a warning role="status".
 * The error summary of the form uses this too, with tabindex="-1" and no role, because it takes focus.
 */
import Icon from "./Icon.astro";

interface Props {
  tone: "success" | "warning" | "error";
  class?: string;
  [attribute: string]: unknown;
}

const { tone, class: className, ...rest } = Astro.props;

const rule = {
  success: "border-l-success",
  warning: "border-l-warning",
  error: "border-l-error",
} as const;

const ink = {
  success: "text-success",
  warning: "text-warning",
  error: "text-error",
} as const;
---

<div
  class:list={[
    "flex items-start gap-4 border border-l-4 border-border bg-surface px-6 py-5 text-fg",
    rule[tone],
    className,
  ]}
  {...rest}
>
  <Icon name={tone} class:list={["size-6", ink[tone]]} />
  <div class="min-w-0"><slot /></div>
</div>

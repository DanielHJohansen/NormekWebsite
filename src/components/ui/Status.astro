---
/**
 * A status message (tokens.md 5.9): the surface colour, a 4 px left rule, an icon and text.
 * The glyph of the icon differs from state to state, so colour is never the only cue.
 * Success uses role="status", a failure role="alert", a warning role="status".
 * The error summary of the form uses this too, with tabindex="-1" and no role="alert", because it takes focus.
 * The text may break anywhere, so a long address or tag never pushes the page wider at 200 percent text on a phone (QA-07).
 */
import Icon from "./Icon.astro";

interface Props {
  tone: "success" | "warning" | "error";
  class?: string;
  [attribute: string]: unknown;
}

const { tone, class: className, ...rest } = Astro.props;

const rule = {
  success: "border-l-success",
  warning: "border-l-warning",
  error: "border-l-error",
} as const;

const ink = {
  success: "text-success",
  warning: "text-warning",
  error: "text-error",
} as const;
---

<div
  class:list={[
    "flex items-start gap-3 border border-l-4 border-border bg-surface px-7 py-6 text-fg",
    rule[tone],
    className,
  ]}
  {...rest}
>
  <Icon name={tone} class:list={["mt-1", ink[tone]]} />
  <div class="min-w-0 [overflow-wrap:anywhere]">
    <slot />
  </div>
</div>

---
/**
 * Buttons (tokens.md 5.2 and 5.3). The primary action is a Signal fill with an Ink label (5.54:1), and white on
 * Signal fails contrast. The secondary button is a 2 px outline that fills on hover. On an Ink band the same
 * classes follow the swapped tokens. Radius 2 px, never chamfered. One primary Signal fill per view.
 * Heights: 52 px for the main buttons, 44 px (size "sm") in the header. No transition: changes are instant.
 *
 * It renders a link by default. Pass as="button" for a form button.
 * A sending button keeps its focus, so it carries aria-disabled and never the disabled attribute.
 */
interface Props {
  as?: "a" | "button";
  href?: string;
  type?: "button" | "submit";
  variant?: "primary" | "secondary";
  size?: "md" | "sm";
  class?: string;
  id?: string;
  /** Any other attribute goes to the element, for example aria-disabled or data-*. */
  [attribute: string]: unknown;
}

const {
  as: Tag = "a",
  href,
  type,
  variant = "primary",
  size = "md",
  class: className,
  ...rest
} = Astro.props;

// Sending and disabled look the same (Paper 200 fill, Muted label, 5.03:1). Sending is aria-disabled with a progress
// cursor and no hover change. The disabled attribute is only the state before the script starts (not-allowed cursor).
const variants = {
  primary:
    "bg-accent text-on-accent hover:bg-accent-hover active:bg-accent-hover active:shadow-[inset_0_0_0_2px_var(--color-on-accent)] aria-disabled:cursor-progress aria-disabled:bg-paper-200 aria-disabled:text-muted aria-disabled:hover:bg-paper-200 aria-disabled:active:shadow-none disabled:cursor-not-allowed disabled:bg-paper-200 disabled:text-muted disabled:hover:bg-paper-200 disabled:active:shadow-none",
  secondary:
    "border-2 border-fg text-fg hover:bg-fg hover:text-bg active:bg-fg active:text-bg active:shadow-[inset_0_0_0_2px_var(--color-bg)]",
} as const;

const sizes = {
  md: "min-h-(--target-primary) px-7 text-base",
  sm: "min-h-(--target-min) px-5 text-sm",
} as const;
---

<Tag
  href={Tag === "a" ? href : undefined}
  type={Tag === "button" ? (type ?? "button") : undefined}
  class:list={[
    "inline-flex cursor-pointer items-center justify-center rounded-sm text-center font-semibold",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>

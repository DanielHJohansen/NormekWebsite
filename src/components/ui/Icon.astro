---
/**
 * Status icons (tokens.md 5.9), the ones the canvas draws. 20 px, 2 px stroke, in the text colour of the parent:
 * success is a circle with a tick, error a circle with a cross, warning a triangle with a bar and a dot.
 * The glyph differs as well as the colour, so a state never rests on colour alone.
 */
interface Props {
  name: "success" | "warning" | "error";
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  viewBox="0 0 20 20"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  aria-hidden="true"
  focusable="false"
  class:list={["size-5 flex-none", className]}
>
  {name === "success" && (
    <>
      <circle cx="10" cy="10" r="8" />
      <path d="M6 10.5L9 13.5L14 7.5" />
    </>
  )}
  {name === "error" && (
    <>
      <circle cx="10" cy="10" r="8" />
      <path d="M7 7L13 13M13 7L7 13" />
    </>
  )}
  {name === "warning" && (
    <>
      <path d="M10 2.5L18 16.5H2Z" stroke-linejoin="round" />
      <path d="M10 8V11.5" />
      <circle cx="10" cy="14" r="1.1" fill="currentColor" stroke="none" />
    </>
  )}
</svg>

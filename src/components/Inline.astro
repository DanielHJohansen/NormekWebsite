---
/**
 * Renders a string from the content with its inline markup: links, strong text, the site's address and
 * [TO CONFIRM] placeholders (see src/lib/inline.ts). It builds elements, never HTML from a string.
 *
 * The text goes in with set:text, not between the tags. Astro keeps the line breaks that Prettier adds between
 * a tag and an expression, and inside a link that would show as an underlined space before a full stop.
 */
import { SITE } from "../config/site";
import { bindShortWords, parseInline } from "../lib/inline";

interface Props {
  text: string;
  /** The class of every link in the text. Use "link link-standalone" for a link on its own line. */
  linkClass?: string;
}

const { text, linkClass = "link" } = Astro.props;
const tokens = parseInline(text);
---

{tokens.map((token) => {
  if (token.type === "placeholder") return <span class="tbc" set:text={token.text} />;
  if (token.type === "strong")
    return <strong class="font-semibold text-fg" set:text={token.text} />;
  if (token.type === "link") return <a class={linkClass} href={token.href} set:text={token.text} />;
  if (token.type === "email")
    return token.link ? (
      <a class={linkClass} href={`mailto:${SITE.email}`} set:text={SITE.email} />
    ) : (
      SITE.email
    );
  return bindShortWords(token.text);
})}

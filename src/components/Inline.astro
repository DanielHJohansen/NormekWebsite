---
/**
 * Renders a string from the content with its inline markup: links, strong text, the site's address and
 * [TO CONFIRM] placeholders (see src/lib/inline.ts). It builds elements, never HTML from a string.
 */
import { SITE } from "../config/site";
import { parseInline } from "../lib/inline";

interface Props {
  text: string;
  /** The class of every link in the text. Use "link link-standalone" for a link on its own line. */
  linkClass?: string;
}

const { text, linkClass = "link" } = Astro.props;
const tokens = parseInline(text);
---

{
  tokens.map((token) => {
    if (token.type === "placeholder") return <span class="tbc">{token.text}</span>;
    if (token.type === "strong") return <strong class="font-semibold text-fg">{token.text}</strong>;
    if (token.type === "link")
      return (
        <a class={linkClass} href={token.href}>
          {token.text}
        </a>
      );
    if (token.type === "email")
      return token.link ? (
        <a class={linkClass} href={`mailto:${SITE.email}`}>
          {SITE.email}
        </a>
      ) : (
        SITE.email
      );
    return token.text;
  })
}

---
/**
 * The header (tokens.md 5.17). No sticky behaviour and no menu button in v0.
 * Below 768 px the lockup is 28 px high, from 768 px it is 32 px. The four links start at 1280 px,
 * because the full header needs 765 px of content and overflows below 832 px. The button is the outline
 * variant, so the first screen carries one Signal fill only (the hero button).
 */
import Logo from "./ui/Logo.astro";
import Button from "./ui/Button.astro";
import { SITE } from "../config/site";
import { homePath } from "../lib/routes";
import type { NavLink } from "../lib/nav";

interface Props {
  nav: readonly NavLink[];
  lang: string;
  /** Shown above the bar when the page is a draft in the private preview. */
  draft?: boolean;
}

const { nav, lang, draft = false } = Astro.props;
---

<header class="border-b border-border bg-bg">
  {draft && (
    <p
      data-draft-banner
      class="bg-signal-100 px-4 py-2 text-center font-mono text-sm text-signal-800"
    >
      Draft page. Not published. Shown only in the private preview.
    </p>
  )}
  <div class="mx-auto flex max-w-page items-center justify-between gap-6 px-gutter py-4">
    <a href={homePath(lang)} class="inline-flex min-h-(--target-min) items-center">
      <Logo class="h-7 w-auto md:h-8" />
    </a>

    <nav aria-label="Main" class="flex items-center gap-8">
      {nav.length > 0 && (
        <ul role="list" class="hidden items-center gap-8 lg:flex">
          {nav.map((link) => (
            <li>
              <a href={link.href} class="nav-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
      <Button variant="secondary" size="sm" href={SITE.cta.href}>
        {SITE.cta.shortLabel}
      </Button>
    </nav>
  </div>
</header>

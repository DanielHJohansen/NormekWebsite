---
/**
 * The one component for everything search engines and browsers read from <head>.
 * Fed from page data, so no page writes these tags by hand.
 *
 * Until launch every page says noindex. PUBLIC_INDEXABLE=true removes it (robots.txt follows),
 * except on a page that sets `noindex`, like /thanks/ and the 404 page, which stay out of search for good.
 * Link previews (Open Graph and the Twitter card) are written from the site origin, because both need absolute
 * addresses. The origin is `site` in astro.config.mjs, which is SITE_URL (default https://www.normek.dk, the preview
 * alias in the Preview environment). With no site there is nothing to make absolute, so the tags are left out, and so
 * they are on a page that sets `noindex` (/thanks/ and the 404 page are not pages anyone shares).
 *
 * TODO(seo-analytics-specialist): JSON-LD comes when the name is cleared. It is an inline script element, which the CSP
 * and check-dist forbid. Agree on an exception with security-engineer first.
 */
import { SITE } from "../config/site";
import { FLAGS } from "../lib/flags";

interface Props {
  /** The whole <title>. No suffix is added. */
  title?: string | undefined;
  description?: string | undefined;
  /** Pass false on pages that must not name a canonical URL, like the 404 page. */
  canonical?: boolean;
  /** True keeps the page out of search at launch too. */
  noindex?: boolean;
}

const {
  title = SITE.homeTitle,
  description = SITE.description,
  canonical = true,
  noindex = false,
} = Astro.props;
const keepOut = !FLAGS.indexable || noindex;
const canonicalUrl =
  !keepOut && canonical && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const origin = Astro.site?.origin;
const share = origin !== undefined && !noindex;
const pageUrl = origin ? new URL(Astro.url.pathname, origin).href : undefined;
const image = origin ? new URL(SITE.socialImage.path, origin).href : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
{keepOut && <meta name="robots" content="noindex, nofollow" />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{share && (
  <>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(SITE.socialImage.width)} />
    <meta property="og:image:height" content={String(SITE.socialImage.height)} />
    <meta property="og:image:alt" content={SITE.socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={SITE.socialImage.alt} />
  </>
)}
<meta name="theme-color" content={SITE.themeColor} />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

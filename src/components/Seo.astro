---
/**
 * The one component for everything search engines and browsers read from <head>.
 * Fed from page data, so no page writes these tags by hand.
 *
 * Until launch every page says noindex. PUBLIC_INDEXABLE=true removes it (robots.txt follows),
 * except on a page that sets `noindex`, like /thanks/ and the 404 page, which stay out of search for good.
 * TODO(seo-analytics-specialist): Open Graph, Twitter card and JSON-LD come when the name is cleared.
 * JSON-LD is an inline script element, which the CSP and check-dist forbid. Agree on an exception
 * with security-engineer first.
 */
import { SITE } from "../config/site";
import { FLAGS } from "../lib/flags";

interface Props {
  /** The whole <title>. No suffix is added. */
  title?: string | undefined;
  description?: string | undefined;
  /** Pass false on pages that must not name a canonical URL, like the 404 page. */
  canonical?: boolean;
  /** True keeps the page out of search at launch too. */
  noindex?: boolean;
}

const {
  title = SITE.homeTitle,
  description = SITE.description,
  canonical = true,
  noindex = false,
} = Astro.props;
const keepOut = !FLAGS.indexable || noindex;
const canonicalUrl =
  !keepOut && canonical && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
{keepOut && <meta name="robots" content="noindex, nofollow" />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<meta name="theme-color" content={SITE.themeColor} />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

---
/**
 * The inquiry form. Four required fields, a honeypot and a Turnstile token (docs/copy/v0-home-copy.md section 3).
 * Every string comes from the content. The behaviour is in src/scripts/contact-form.ts.
 * The form needs JavaScript: the submit button stays disabled until the script starts, and a noscript notice
 * names the email address. The messages travel to the script in an inert <template>, so no inline script is needed.
 *
 * The Turnstile site key is read at build time from PUBLIC_TURNSTILE_SITE_KEY. When it is empty (the preview before
 * the Cloudflare setup) the form still renders, and a submit shows the "send failed" text.
 */
import Inline from "../Inline.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import Status from "../ui/Status.astro";
import { LIMITS } from "../../lib/contact-form";
import type { FormCopy } from "../../lib/schemas";

interface Props {
  form: FormCopy;
}

const { form } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

const labelClass = "mb-2 block text-sm font-semibold";
const fieldClass =
  "block w-full min-h-(--target-input) rounded-sm border border-border-strong bg-surface px-4 text-fg hover:border-fg focus-visible:border-fg aria-invalid:border-error aria-invalid:shadow-[inset_0_0_0_1px_var(--color-error)]";
const errorClass = "mt-2 flex items-start gap-2 text-sm text-error";

const fields = [
  { name: "name", type: "text", autocomplete: "name", copy: form.name },
  { name: "email", type: "email", autocomplete: "email", copy: form.email },
  { name: "company", type: "text", autocomplete: "organization", copy: form.company },
] as const;
---

<form
  id="contact-form"
  method="post"
  action="/api/contact"
  novalidate
  data-contact-form
  data-endpoint="/api/contact"
  data-thanks="/thanks/"
  data-sitekey={siteKey}
  class="flex flex-col gap-5 border border-border bg-surface p-panel"
>
  <noscript>
    <Status tone="warning">
      <p>
        <Inline text={form.noscript} />
      </p>
    </Status>
  </noscript>

  <Status
    tone="error"
    id="contact-summary"
    tabindex="-1"
    role="group"
    hidden
    aria-labelledby="contact-summary-title"
  >
    <p id="contact-summary-title" class="font-semibold">
      {form.summaryTitle}
    </p>
    <ul data-summary-list class="mt-2 flex flex-col gap-2"></ul>
  </Status>

  <p class="text-sm text-muted">{form.required}</p>

  {fields.map((field) => (
    <div>
      <label for={`contact-${field.name}`} class={labelClass}>
        {field.copy.label}
      </label>
      <input
        id={`contact-${field.name}`}
        name={field.name}
        type={field.type}
        autocomplete={field.autocomplete}
        maxlength={LIMITS[field.name]}
        required
        class={fieldClass}
      />
      <p id={`contact-${field.name}-error`} hidden class={errorClass}>
        <Icon name="error" class="mt-0.5" />
        <span data-error-text />
      </p>
    </div>
  ))}

  <div>
    <label for="contact-message" class={labelClass}>
      {form.message.label}
    </label>
    <p id="contact-message-help" class="mb-2 max-w-measure text-sm text-muted">
      {form.message.help}
    </p>
    <textarea
      id="contact-message"
      name="message"
      maxlength={LIMITS.message}
      required
      rows="5"
      aria-describedby="contact-message-help"
      class:list={[fieldClass, "min-h-35 resize-y py-3"]}
    ></textarea>
    <p id="contact-message-error" hidden class={errorClass}>
      <Icon name="error" class="mt-0.5" />
      <span data-error-text />
    </p>
  </div>

  <div aria-hidden="true" class="sr-only">
    <label for="contact-website">{form.honeypot}</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div data-turnstile></div>

  <div id="contact-notice" role="alert" class="empty:hidden"></div>
  <div id="contact-warning" role="status" class="empty:hidden"></div>

  <Button as="button" type="submit" id="contact-submit" disabled class="self-start">
    {form.submit}
  </Button>

  <p class="max-w-measure text-sm text-muted">
    <Inline text={form.privacy} />
  </p>

  <template data-messages>
    <p data-message="name.empty">{form.name.empty}</p>
    <p data-message="email.empty">{form.email.empty}</p>
    <p data-message="email.no-at">{form.email.noAt}</p>
    <p data-message="email.invalid">{form.email.invalid}</p>
    <p data-message="company.empty">{form.company.empty}</p>
    <p data-message="message.too-short">{form.message.tooShort}</p>
    <p data-message="message.too-long">{form.message.tooLong}</p>
    <p data-message="button.sending">{form.sending}</p>
  </template>
  <template data-notice="failed">
    <Status tone="error">
      <p>
        <Inline text={form.failed} />
      </p>
    </Status>
  </template>
  <template data-notice="person-check">
    <Status tone="warning">
      <p>
        <Inline text={form.personCheck} />
      </p>
    </Status>
  </template>
</form>

<script>
  import "../../scripts/contact-form";
</script>

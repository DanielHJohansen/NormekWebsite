---
import { render, type CollectionEntry } from "astro:content";
import Button from "../ui/Button.astro";
import DraftBadge from "../ui/DraftBadge.astro";
import { isDraft } from "../../lib/drafts";

interface Props {
  entry: CollectionEntry<"home">;
}

const { entry } = Astro.props;
const { data } = entry;
const draft = isDraft(entry);
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
---

<section
  id={data.id}
  aria-labelledby={`${data.id}-heading`}
  data-draft={draft ? "true" : undefined}
  class="border-t border-border"
>
  <div class="mx-auto max-w-page px-4 py-12 md:px-6 md:py-16 lg:px-8 lg:py-24">
    {draft && <DraftBadge />}
    {data.eyebrow && (
      <p class="mb-3 font-mono text-sm uppercase tracking-eyebrow text-muted">{data.eyebrow}</p>
    )}
    <h2 id={`${data.id}-heading`} class="max-w-heading text-2xl">
      {data.heading}
    </h2>
    {data.lead && <p class="mt-4 max-w-prose text-lg">{data.lead}</p>}
    {data.items.length > 0 && (
      <ul class="mt-8 grid gap-6 md:grid-cols-3">
        {data.items.map((item) => (
          <li class="border border-border bg-surface p-6">
            <h3 class="text-xl">{item.title}</h3>
            <p class="mt-2">{item.body}</p>
          </li>
        ))}
      </ul>
    )}
    {hasBody && (
      <div class="prose mt-8">
        <Content />
      </div>
    )}
    {data.cta && (
      <div class="mt-8">
        <Button href={data.cta.href}>{data.cta.label}</Button>
      </div>
    )}
  </div>
</section>

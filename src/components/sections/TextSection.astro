---
import { render, type CollectionEntry } from "astro:content";
import Inline from "../Inline.astro";
import SectionShell from "../SectionShell.astro";
import type { SectionOf } from "../../lib/schemas";

/** A heading and Markdown text. It is for a future section, and it stays a draft until the text is ready. */
interface Props {
  data: SectionOf<"text">;
  entry: CollectionEntry<"home">;
  draft?: boolean;
}

const { data, entry, draft = false } = Astro.props;
const { Content } = await render(entry);
---

<SectionShell id={data.id} {draft}>
  {data.eyebrow && <p class="eyebrow mb-3"><Inline text={data.eyebrow} /></p>}
  <h2 id={`${data.id}-heading`} class="mb-6 text-2xl"><Inline text={data.heading} /></h2>
  <div class="prose max-w-measure-md">
    <Content />
  </div>
</SectionShell>

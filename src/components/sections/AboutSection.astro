---
import type { CollectionEntry } from "astro:content";
import Inline from "../Inline.astro";
import Markdown from "../Markdown.astro";
import SectionShell from "../SectionShell.astro";
import type { SectionOf } from "../../lib/schemas";

interface Props {
  data: SectionOf<"about">;
  entry: CollectionEntry<"home">;
  draft?: boolean;
}

const { data, entry, draft = false } = Astro.props;
---

<SectionShell
  id={data.id}
  {draft}
  rule={false}
  innerClass="flex flex-wrap items-start gap-x-columns gap-y-columns"
>
  <div class="min-w-0 max-w-110 flex-1 basis-80">
    <div class="frame aspect-4/5">
      <div class="frame-inner flex h-full items-end p-5">
        <span class="tbc inline-block bg-surface px-2 py-1 text-muted">{data.photoLabel}</span>
      </div>
    </div>
  </div>
  <div class="min-w-0 grow-2 basis-120">
    {data.eyebrow && (
      <p class="eyebrow mb-3">
        <Inline text={data.eyebrow} />
      </p>
    )}
    <h2 id={`${data.id}-heading`} class="mb-6 text-2xl">
      <Inline text={data.heading} />
    </h2>
    <div class="prose">
      <Markdown {entry} />
    </div>
    <ul role="list" class="mt-6 flex flex-wrap gap-x-7">
      {data.links.map((link) => (
        <li class="inline-flex min-h-(--target-min) items-center gap-2">
          <Inline text={link} linkClass="link link-standalone" />
        </li>
      ))}
    </ul>
  </div>
</SectionShell>

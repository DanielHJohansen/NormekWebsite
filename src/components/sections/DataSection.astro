---
import Inline from "../Inline.astro";
import SectionShell from "../SectionShell.astro";
import type { SectionOf } from "../../lib/schemas";

interface Props {
  data: SectionOf<"data">;
  draft?: boolean;
}

const { data, draft = false } = Astro.props;
---

<SectionShell id={data.id} {draft} ink>
  {data.eyebrow && <p class="eyebrow mb-3"><Inline text={data.eyebrow} /></p>}
  <h2 id={`${data.id}-heading`} class="mb-10 text-2xl"><Inline text={data.heading} /></h2>
  <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] gap-x-14">
    {
      data.items.map((item) => (
        <li class="border-t border-border py-5 text-muted">
          <Inline text={item} />
        </li>
      ))
    }
  </ul>
  <p class="mt-8"><Inline text={data.link} linkClass="link link-standalone" /></p>
</SectionShell>

---
import Inline from "../Inline.astro";
import SectionShell from "../SectionShell.astro";
import Button from "../ui/Button.astro";
import { SITE } from "../../config/site";
import { getOffers } from "../../lib/content";
import type { SectionOf } from "../../lib/schemas";

interface Props {
  data: SectionOf<"offers">;
  draft?: boolean;
}

const { data, draft = false } = Astro.props;
const { labels } = data;
const offers = await getOffers();
---

<SectionShell id={data.id} {draft}>
  {data.eyebrow && <p class="eyebrow mb-3"><Inline text={data.eyebrow} /></p>}
  <h2 id={`${data.id}-heading`} class="mb-4 text-2xl"><Inline text={data.heading} /></h2>
  <p class="mb-10 max-w-measure-lg text-muted"><Inline text={data.lead} /></p>

  <ol class="border-t-2 border-fg">
    {
      offers.map((offer, index) => (
        <li class="flex flex-wrap gap-x-12 gap-y-6 border-b border-border py-8">
          <div class="min-w-0 flex-1 basis-70">
            <p class="mb-2 font-mono text-xs tracking-eyebrow text-muted uppercase">
              {labels.stage} {index + 1}
            </p>
            <h3 class="mb-2 text-xl"><Inline text={offer.data.name} /></h3>
            <p class="text-muted"><Inline text={offer.data.summary} /></p>
          </div>
          <div class="min-w-0 grow-2 basis-90">
            <p class="mb-2 font-mono text-xs tracking-eyebrow text-muted uppercase">
              {labels.youGet}
            </p>
            <p><Inline text={offer.data.youGet} /></p>
          </div>
          <div class="min-w-0 grow-[1.4] basis-70">
            <p class="mb-2 font-mono text-xs tracking-eyebrow text-muted uppercase">
              {labels.iNeed}
            </p>
            <p><Inline text={offer.data.iNeed} /></p>
            {offer.data.notIncluded && (
              <>
                <p class="mt-5 mb-2 font-mono text-xs tracking-eyebrow text-muted uppercase">
                  {labels.notIncluded}
                </p>
                <p><Inline text={offer.data.notIncluded} /></p>
              </>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <div class="mt-10">
    <Button variant="secondary" href={SITE.cta.anchor}>{SITE.cta.label}</Button>
  </div>
</SectionShell>

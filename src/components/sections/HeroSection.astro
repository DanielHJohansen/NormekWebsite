---
import EnclosureSection from "../illustrations/EnclosureSection.astro";
import Inline from "../Inline.astro";
import SectionShell from "../SectionShell.astro";
import Button from "../ui/Button.astro";
import { SITE } from "../../config/site";
import { plainText } from "../../lib/inline";
import type { SectionOf } from "../../lib/schemas";

interface Props {
  data: SectionOf<"hero">;
  draft?: boolean;
}

const { data, draft = false } = Astro.props;
---

<SectionShell id={data.id} {draft} rule={false} pad="hero" innerClass="flex flex-wrap items-center gap-split">
  <div class="min-w-0 flex-1 basis-120">
    {data.eyebrow && <p class="eyebrow mb-5"><Inline text={data.eyebrow} /></p>}
    <h1 id={`${data.id}-heading`} class="mb-6 text-4xl"><Inline text={data.heading} /></h1>
    <p class="mb-8 max-w-measure-sm text-lg text-muted"><Inline text={data.subhead} /></p>
    <div class="flex flex-wrap items-center gap-x-7 gap-y-4">
      <Button href={SITE.cta.anchor}>{SITE.cta.label}</Button>
      <a class="link" href={`mailto:${SITE.email}`}>{plainText(data.emailLabel, SITE.email)}</a>
    </div>
    <p class="mt-10 border-t border-border pt-5 font-mono text-sm text-muted">
      <Inline text={data.ledBy} />
    </p>
  </div>
  <figure class="m-0 min-w-0 flex-1 basis-95">
    <div class="chamfer bg-surface p-panel inset-ring-1 inset-ring-border">
      <EnclosureSection />
    </div>
    <figcaption class="mt-3 font-mono text-sm text-muted"><Inline text={data.caption} /></figcaption>
  </figure>
</SectionShell>

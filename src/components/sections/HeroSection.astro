---
import Inline from "../Inline.astro";
import SectionShell from "../SectionShell.astro";
import Button from "../ui/Button.astro";
import { SITE } from "../../config/site";
import { plainText } from "../../lib/inline";
import type { SectionOf } from "../../lib/schemas";
// The drawing is the file from the visual-media-producer. The outlined version turns text into paths,
// so it needs no font when it is shown as an image.
import illustration from "../../assets/illustrations/enclosure-section-outlined.svg?url";

interface Props {
  data: SectionOf<"hero">;
  draft?: boolean;
}

const { data, draft = false } = Astro.props;
---

<SectionShell
  id={data.id}
  {draft}
  rule={false}
  pad="hero"
  innerClass="flex flex-wrap items-center gap-x-columns gap-y-columns"
>
  <div class="min-w-0 flex-1 basis-120">
    {data.eyebrow && <p class="eyebrow mb-5"><Inline text={data.eyebrow} /></p>}
    <h1 id={`${data.id}-heading`} class="mb-6 text-4xl"><Inline text={data.heading} /></h1>
    <p class="mb-8 max-w-measure text-lg text-muted"><Inline text={data.subhead} /></p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
      <Button href={SITE.cta.anchor}>{SITE.cta.label}</Button>
      <p class="max-w-[16em] text-sm text-muted"><Inline text={data.buttonNote} /></p>
    </div>
    <p class="mt-2">
      <a class="link link-standalone" href={`mailto:${SITE.email}`}
        >{plainText(data.emailLabel, SITE.email)}</a
      >
    </p>
    <p class="mt-10 border-t border-border pt-5 font-mono text-sm text-muted">
      <Inline text={data.byline} />
    </p>
  </div>
  <figure class="m-0 min-w-0 flex-1 basis-95">
    <div class="frame">
      <div class="frame-inner p-panel">
        <img
          src={illustration}
          width="560"
          height="440"
          alt={data.figureAlt}
          class="block h-auto w-full"
        />
      </div>
    </div>
    <figcaption class="mt-3 font-mono text-sm text-muted"><Inline text={data.caption} /></figcaption>
  </figure>
</SectionShell>

---
import Inline from "../Inline.astro";
import SectionShell from "../SectionShell.astro";
import { SITE } from "../../config/site";
import { plainText } from "../../lib/inline";
import type { SectionOf } from "../../lib/schemas";

interface Props {
  data: SectionOf<"problem">;
  draft?: boolean;
}

const { data, draft = false } = Astro.props;

/** "Tell me about this: the board is done and there is no box" names the card the link belongs to. */
function linkName(title: string): string {
  const plain = plainText(title, SITE.email).replace(/\.$/, "");
  return `${data.cardLink}: ${plain.charAt(0).toLowerCase()}${plain.slice(1)}`;
}
---

<SectionShell id={data.id} {draft}>
  {data.eyebrow && <p class="eyebrow mb-3"><Inline text={data.eyebrow} /></p>}
  <h2 id={`${data.id}-heading`} class="mb-10 text-2xl"><Inline text={data.heading} /></h2>
  <ul class="flex flex-wrap gap-6">
    {
      data.cards.map((card, index) => (
        <li class="flex min-w-0 flex-1 basis-75 flex-col gap-3 border border-border bg-surface p-7">
          <p class="font-mono text-xs tracking-eyebrow text-muted">
            {String(index + 1).padStart(2, "0")}
          </p>
          <h3 class="text-xl"><Inline text={card.title} /></h3>
          <p class="text-muted"><Inline text={card.text} /></p>
          <a class="link mt-auto pt-2" href={SITE.cta.anchor} aria-label={linkName(card.title)}>
            {data.cardLink}
          </a>
        </li>
      ))
    }
  </ul>
</SectionShell>

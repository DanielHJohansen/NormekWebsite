# Exact versions only: the lockfile and package.json agree, and nothing floats.
save-exact=true
# Fail early on a Node version the toolchain does not support (see .nvmrc).
engine-strict=true
# Quieter installs. Advisories are checked in CI with npm audit.
fund=false
# Dependencies never run install scripts here or on Cloudflare's build (threat model R8, review S4).
ignore-scripts=true

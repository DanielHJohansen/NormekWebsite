# Copy to .env for local work. This file is committed, so it never holds a secret.
# Secrets (the Turnstile secret key, the Resend API key) live in the Cloudflare Pages settings.
# For local testing of the contact function they go in .dev.vars, which is gitignored.

# Private preview only. true builds draft pages and sections and shows them with a banner.
# Set it in the Cloudflare Pages Preview environment, never in Production.
SHOW_DRAFTS=false

# Launch switch. true removes the noindex meta tag and opens robots.txt.
# Never together with SHOW_DRAFTS (the build stops). Leave it false until the name is cleared
# and Daniel says go. The catch-all X-Robots-Tag in public/_headers needs its own change at launch.
PUBLIC_INDEXABLE=false

# Origin for absolute URLs in the sitemap and canonical links. Optional.
# SITE_URL=https://www.normek.dk

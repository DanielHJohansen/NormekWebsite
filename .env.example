# Copy to .env for local work. This file is committed, so it never holds a secret.
# Secrets (the Turnstile secret key, the Resend API key) live in the Cloudflare Pages settings.
# For local testing of the contact function they go in .dev.vars, which is gitignored.

# Private preview only. true builds draft pages and sections and shows them with a banner.
# Set it in the Cloudflare Pages Preview environment, never in Production.
SHOW_DRAFTS=false

# Launch switch. true removes the noindex meta tag and opens robots.txt.
# Never together with SHOW_DRAFTS (the build stops). Leave it false until the name is cleared
# and Daniel says go. The build writes dist/_headers from public/_headers: with this flag it drops the global
# X-Robots-Tag and adds noindex rules for the pages.dev addresses (scripts/lib/build-headers.mjs).
# A launch build also needs PUBLIC_TURNSTILE_SITE_KEY below, and npm run check:dist fails without it.
PUBLIC_INDEXABLE=false

# Origin for absolute URLs in the sitemap, the canonical links and the link preview tags (og:image and the rest).
# Optional: the default is https://www.normek.dk. Set it to the preview alias in the Preview environment, so the
# preview card finds its image there. Never set it to an empty value: the build stops with "Invalid URL".
# SITE_URL=https://www.normek.dk

# The public site key of the Cloudflare Turnstile widget (not a secret, it ends up in the page).
# Read at build time. Empty is fine before the Cloudflare setup: the form renders and shows the
# "send failed" text on submit. The secret key never goes here, it lives in the Pages settings.
# Never put Cloudflare's dummy test keys here either, they belong in tests only.
PUBLIC_TURNSTILE_SITE_KEY=

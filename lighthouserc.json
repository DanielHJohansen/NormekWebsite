{
  "$comment": "Lighthouse CI budgets from docs/plan/work-breakdown.md section 6. Run by .github/workflows/ci.yml against a build made with PUBLIC_INDEXABLE=true (otherwise the SEO audit fails on noindex). Sizes are gzip transfer sizes from LHCI's own compressing static server, in KiB (1 KiB = 1024 bytes). Each assertion uses the median of 3 runs. Mobile emulation with simulated slow 4G is the Lighthouse default. Pages are discovered from dist/ (home is /index.html here). Every page other than home has a JavaScript budget of 0, so a new page that needs script must be added to the home entry or get its own entry on purpose. The SEO score on /404.html is a warning only, because a 404 page may carry noindex. Not measurable here, so checked elsewhere: response headers (security-engineer's preview gate), hero image alone (the image assertion counts all images on the page), and font family count (design review).",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "maxAutodiscoverUrls": 0,
      "staticDirFileDiscoveryDepth": 4,
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:\\d+/",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-blocking-time": ["error", { "maxNumericValue": 100 }],
            "total-byte-weight": ["error", { "maxNumericValue": 512000 }],
            "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30720 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 102400 }],
            "resource-summary:image:size": ["error", { "maxNumericValue": 153600 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:\\d+/(?!404\\.html$)",
          "aggregationMethod": "median",
          "assertions": {
            "categories:seo": ["error", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:\\d+/404\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:seo": ["warn", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:\\d+/(index\\.html)?$",
          "aggregationMethod": "median",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 10240 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:\\d+/(?!(index\\.html)?$)",
          "aggregationMethod": "median",
          "assertions": {
            "resource-summary:script:size": ["error", { "maxNumericValue": 0 }]
          }
        }
      ]
    }
  }
}
